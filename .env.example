# Copy this file to .env and fill in your own values. NEVER commit .env (it is gitignored).

# --- Nebius Token Factory (inference + Sandboxes use the same key) ---
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Model per tier: copy exact model IDs from the Token Factory model list ---
# (run `python scripts/check_setup.py` to print the Nemotron IDs your account can see)
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# --- GitHub (read-only token for public repos; avoids the 60 requests/hour limit) ---
GITHUB_TOKEN=
# --- LLM client tuning (optional; defaults shown) ---
LLM_MAX_TOKENS_NANO=4000
LLM_MAX_TOKENS_SUPER=12000
LLM_MAX_TOKENS_ULTRA=16000
LLM_TIMEOUT_S=180
LLM_RETRIES=2
# --- Server (python -m itr.api) ---
ITR_DB_PATH=data/itr.db
SANDBOX_BACKEND=docker          # docker | nebius
MAX_CONCURRENT_RUNS=2           # extra POST /runs get HTTP 429 (protects credits on the public demo)
ALLOW_NEW_RUNS=true             # false = replay-only public demo (no model or sandbox spend)
